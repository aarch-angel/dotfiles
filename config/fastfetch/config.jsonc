{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "position": "left",
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "weather",
    "break",
    "colors",
  ],
  "display": {
    "disableLinewrap": true,
    "temp": { "unit": "C" },
    "key": { "type": "icon" },
    "separator": "  ",
  },
}
